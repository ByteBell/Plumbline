{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "deny",
    "edit": "allow",
    "webfetch": "deny"
  },
  "mcp": {
    "plumbline": {
      "type": "remote",
      "url": "http://localhost/mcp?access_token=${PLUMBLINE_MCP_TOKEN}",
      "enabled": true
    }
  },
  "agent": {
    "plumbline-arm": {
      "mode": "primary",
      "description": "plumbline-MCP-only retrieval arm",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "read": false,
        "patch": false,
        "grep": false,
        "glob": false,
        "list": false,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "task": false,
        "invalid": false,
        "skill": false,
        "plumbline*": true
      },
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    },
    "plumbline-arm-scored": {
      "mode": "primary",
      "description": "plumbline-MCP retrieval + PHASE 2 self-scoring: file tools on so it can read ../golden.json and write its own result.json. NOT gold-blind by construction - the prompt is what keeps PHASE 1 honest.",
      "tools": {
        "bash": false,
        "edit": false,
        "write": true,
        "read": true,
        "patch": false,
        "grep": false,
        "glob": false,
        "list": true,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "task": false,
        "invalid": false,
        "skill": false,
        "plumbline*": true
      },
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    }
  }
}
