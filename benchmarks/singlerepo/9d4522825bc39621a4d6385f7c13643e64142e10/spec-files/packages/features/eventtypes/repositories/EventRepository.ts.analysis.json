        "source": "export class EventRepository {\n  static async getPublicEvent(input: TEventInputSchema, userId?: number) {\n    const event = await getPublicEvent(\n      input.username,\n      input.eventSlug,\n      input.isTeamEvent,\n      input.org,\n      prisma,\n      input.fromRedirectOfNonOrgLink,\n      userId\n    );\n    return event;\n  }\n}"
