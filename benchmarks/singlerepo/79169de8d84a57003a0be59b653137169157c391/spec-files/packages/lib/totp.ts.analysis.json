        "source": " */\nexport const totpAuthenticatorCheck = (\n  token: string,\n  secret: string,\n  opts: Partial<AuthenticatorOptions> = {}\n) => {\n  const { window = [1, 0], ...rest } = opts;\n  const authenticator = new Authenticator({\n    createDigest,\n    createRandomBytes,\n    keyDecoder,\n    keyEncoder,\n    window,\n    ...rest,\n  });\n  return authenticator.check(token, secret);"
