        "startLine": 2,
        "endLine": 6,
        "isBehavioral": true,
        "source": "export const extractBaseEmail = (email: string): string => {\n  const [localPart, domain] = email.split(\"@\");\n  const baseLocalPart = localPart.split(\"+\")[0];\n  return `${baseLocalPart}@${domain}`;\n};"
      }
