        "source": "type VerifyEmailCodeOptions = {\n  ctx: {\n    user: Pick<NonNullable<TrpcSessionUser>, \"id\">;\n  };\n  input: TVerifyEmailCodeInputSchema;\n};"
      },
      {
        "unitId": "packages/trpc/server/routers/viewer/workflows/verifyEmailCode.handler.ts__verifyEmailCodeHandler_2#function:verifyEmailCodeHandler",
        "unitKind": "function",
        "name": "verifyEmailCodeHandler",
        "qualifiedName": "verifyEmailCodeHandler",
        "parentUnitId": null,
        "startLine": 18,
        "endLine": 41,
        "isBehavioral": true,
        "source": "export const verifyEmailCodeHandler = async ({ ctx, input }: VerifyEmailCodeOptions) => {\n  const { code, email, teamId } = input;\n  const { id } = ctx.user;\n\n  if (!code || !email) throw new TRPCError({ code: \"BAD_REQUEST\" });\n\n  const secret = createHash(\"md5\")\n    .update(email + process.env.CALENDSO_ENCRYPTION_KEY)\n    .digest(\"hex\");\n\n  const isValidToken = totpRawCheck(code, secret, { step: 900 });\n\n  if (!isValidToken) throw new TRPCError({ code: \"BAD_REQUEST\", message: \"invalid_code\" });\n\n  await prisma.verifiedEmail.create({\n    data: {\n      email,\n      userId: id,\n      teamId,\n    },\n  });\n\n  return isValidToken;\n};"
      }
    ]
