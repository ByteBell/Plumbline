      {
        "unitId": "packages/trpc/server/routers/viewer/auth/verifyCodeUnAuthenticated.handler.ts__verifyCodeUnAuthenticated_3#function:verifyCodeUnAuthenticated",
        "unitKind": "function",
        "name": "verifyCodeUnAuthenticated",
        "qualifiedName": "verifyCodeUnAuthenticated",
        "parentUnitId": null,
        "startLine": 16,
        "endLine": 30,
        "isBehavioral": true,
        "source": "export const verifyCodeUnAuthenticated = async (input: ZVerifyCodeInputSchema) => {\n  const { email, code } = input;\n\n  if (!email || !code) throw new TRPCError({ code: \"BAD_REQUEST\" });\n\n  const secret = createHash(\"md5\")\n    .update(email + process.env.CALENDSO_ENCRYPTION_KEY)\n    .digest(\"hex\");\n\n  const isValidToken = totpRawCheck(code, secret, { step: 900 });\n\n  if (!isValidToken) throw new TRPCError({ code: \"BAD_REQUEST\", message: \"invalid_code\" });\n\n  return isValidToken;\n};"
      }
    ],
